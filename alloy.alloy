discovery.kubernetes "kubernetes_pods" {
	role = "pod"

	namespaces {
		names = ["monitoring", "default", "kube-system"]
	}

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + coalesce(sys.env("HOSTNAME"), constants.hostname)
	}
}

discovery.relabel "kubernetes_pods" {
	targets = discovery.kubernetes.kubernetes_pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "__host__"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_namespace", "__meta_kubernetes_pod_name", "__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		regex         = "([^/]+)/([^/]+)/([^/]+)/([^/]+)"
		target_label  = "__path__"
		replacement   = "/var/log/pods/$1_$2_$3/$4/*.log"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		regex         = "promtail"
		action        = "drop"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "instance"
	}
}

loki.source.file "kubernetes_pods" {
	targets    = discovery.relabel.kubernetes_pods.output
	forward_to = [loki.write.default.receiver]

	file_match {
		enabled = true
	}
	legacy_positions_file = "/var/run/promtail/positions.yaml"
}

discovery.kubernetes "promtail" {
	role = "pod"

	namespaces {
		names = ["monitoring"]
	}

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + coalesce(sys.env("HOSTNAME"), constants.hostname)
	}
}

discovery.relabel "promtail" {
	targets = discovery.kubernetes.promtail.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "__host__"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		regex         = "promtail"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_namespace", "__meta_kubernetes_pod_name", "__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		regex         = "([^/]+)/([^/]+)/([^/]+)/([^/]+)"
		target_label  = "__path__"
		replacement   = "/var/log/pods/$1_$2_$3/$4/*.log"
	}
}

loki.source.file "promtail" {
	targets    = discovery.relabel.promtail.output
	forward_to = [loki.write.default.receiver]

	file_match {
		enabled = true
	}
	legacy_positions_file = "/var/run/promtail/positions.yaml"
}

loki.source.file "promtail_static" {
	targets = [{
		__address__ = "localhost",
		__path__    = "/var/log/pods/monitoring_promtail-*_*/promtail/*.log",
		instance    = "${NODE_NAME}",
		job         = "promtail",
		namespace   = "monitoring",
	}]
	forward_to = [loki.write.default.receiver]

	file_match {
		enabled = true
	}
	legacy_positions_file = "/var/run/promtail/positions.yaml"
}

discovery.relabel "journal" {
	targets = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal__hostname"]
		target_label  = "nodename"
	}

	rule {
		source_labels = ["__journal__hostname"]
		target_label  = "node"
	}

	rule {
		target_label = "namespace"
		replacement  = "journal"
	}

	rule {
		target_label = "pod"
		replacement  = "-"
	}
}

loki.source.journal "journal" {
	max_age       = "12h0m0s"
	path          = "/var/log/journal"
	relabel_rules = discovery.relabel.journal.rules
	forward_to    = [loki.write.default.receiver]
	labels        = {
		job = "journal",
	}
}

loki.write "default" {
	endpoint {
		url            = "http://loki:3100/loki/api/v1/push"
		batch_wait     = "2s"
		remote_timeout = "30s"
	}
	external_labels = {}
}
